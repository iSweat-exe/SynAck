# Copy to .env and adjust. Never commit .env.

# Payload CMS: secret used to sign sessions (generate with: openssl rand -base64 32)
PAYLOAD_SECRET=change-me

# Supabase Postgres. Local default: `npm run db:start` (port 54322).
# On Vercel use the Supabase transaction pooler URL (port 6543); for migrations use the session pooler.
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Max connections per server instance (keep it small on serverless)
DATABASE_POOL_MAX=5
